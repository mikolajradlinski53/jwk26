# --- Supabase (Project Settings -> API) ---
NEXT_PUBLIC_SUPABASE_URL=https://twoj-projekt.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...            # klucz anon (publiczny, OK w kliencie)

# --- Sekrety serwerowe (NIE dawaj NEXT_PUBLIC_! nigdy do klienta) ---
SUPABASE_SERVICE_ROLE_KEY=eyJ...                # tylko do zadań serwerowych (np. SMS broadcast)
SMSAPI_TOKEN=                                   # token z SMSAPI.pl (Etap 3)

# Na Cloudflare: NEXT_PUBLIC_* idą przy buildzie, sekrety przez `wrangler secret put`.
