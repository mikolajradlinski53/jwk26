# Supabase — Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Serwerowy. Nigdy z prefiksem NEXT_PUBLIC_ — trafiłby do bundla przeglądarki.
SUPABASE_SERVICE_ROLE_KEY=

# Web push (plan 11). Klucze VAPID: `npx web-push generate-vapid-keys`.
# PUSH_SEKRET = `select wartosc from sekrety where klucz = 'push'` w projekcie.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
PUSH_SEKRET=

# Osobny projekt Supabase tylko na testy (testy kasują dane).
TEST_SUPABASE_URL=
TEST_SUPABASE_ANON_KEY=
TEST_SUPABASE_SERVICE_ROLE_KEY=
